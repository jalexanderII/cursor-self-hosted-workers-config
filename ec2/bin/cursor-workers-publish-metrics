#!/usr/bin/env bash
set -euo pipefail

# Publish local worker health metrics to CloudWatch.
#
# Metrics are derived from this instance's manifest and localhost /readyz
# endpoints, so they represent this EC2 fleet rather than the whole Cursor team.
set -a
# shellcheck source=/dev/null
. /etc/cursor-workers/env
set +a

MANIFEST="${CURSOR_WORKERS_MANIFEST:-/etc/cursor-workers/workers.json}"
METRICS_NAMESPACE="${CURSOR_METRICS_NAMESPACE:-Cursor/SelfHostedWorkers}"

# IMDSv2 is used to attach InstanceId as a metric dimension.
TOKEN="$(curl -sX PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")"

INSTANCE_ID="$(curl -sH "X-aws-ec2-metadata-token: $TOKEN" \
  "http://169.254.169.254/latest/meta-data/instance-id")"

REPO="$(jq -r '.repo' "$MANIFEST")"

total=0
ready=0
claimed=0
failed=0

while read -r worker; do
  id="$(echo "$worker" | jq -r '.id')"
  port="$(echo "$worker" | jq -r '.managementPort')"
  service="cursor-worker-${id}.service"

  total=$((total + 1))

  # systemd state catches failed worker processes even if the management port is
  # not responding.
  if ! systemctl is-active --quiet "$service"; then
    failed=$((failed + 1))
    continue
  fi

  # /readyz HTTP 200 is the public contract for a connected, idle worker.
  if curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:${port}/readyz"; then
    ready=$((ready + 1))
  fi

  # Active-session state comes from the documented Prometheus endpoint instead
  # of relying on the non-contractual JSON body returned by /readyz.
  metrics="$(curl -fsS --max-time 2 "http://127.0.0.1:${port}/metrics" || true)"
  if awk '$1 == "cursor_self_hosted_worker_session_active" && $2 == "1" { found=1 } END { exit !found }' <<<"$metrics"; then
    claimed=$((claimed + 1))
  fi
done < <(jq -c '.workers[]' "$MANIFEST")

# Publish all values in one CloudWatch API request.
metric_data="$(
  jq -n \
    --arg instance_id "$INSTANCE_ID" \
    --arg repo "$REPO" \
    --argjson total "$total" \
    --argjson ready "$ready" \
    --argjson active "$claimed" \
    --argjson failed "$failed" \
    '[
      {MetricName:"TotalWorkers",Dimensions:[{Name:"InstanceId",Value:$instance_id},{Name:"Repo",Value:$repo}],Unit:"Count",Value:$total},
      {MetricName:"ReadyWorkers",Dimensions:[{Name:"InstanceId",Value:$instance_id},{Name:"Repo",Value:$repo}],Unit:"Count",Value:$ready},
      {MetricName:"ActiveWorkers",Dimensions:[{Name:"InstanceId",Value:$instance_id},{Name:"Repo",Value:$repo}],Unit:"Count",Value:$active},
      {MetricName:"FailedWorkerServices",Dimensions:[{Name:"InstanceId",Value:$instance_id},{Name:"Repo",Value:$repo}],Unit:"Count",Value:$failed}
    ]'
)"

aws cloudwatch put-metric-data \
  --region "$AWS_REGION" \
  --namespace "$METRICS_NAMESPACE" \
  --metric-data "$metric_data"
