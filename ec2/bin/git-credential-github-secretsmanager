#!/usr/bin/env bash
set -euo pipefail

# Git credential helper used by HTTPS git clone/fetch/push.
#
# Git calls this script with "get" and sends protocol/host fields on stdin.
# For the configured SCM host, return a username/password pair where the token
# is fetched just-in-time from AWS Secrets Manager. Legacy GITHUB_* variable
# names remain accepted for compatibility.
op="${1:-get}"

case "$op" in
  get)
    host=""

    # Parse git-credential input. We only need "host" to decide whether this
    # helper should answer the request.
    while IFS='=' read -r key value; do
      if [ "$key" = "host" ]; then
        host="$value"
      fi
    done

    # Keep all deployment-specific values in one root-managed env file.
    set -a
    # shellcheck source=/dev/null
    . /etc/cursor-workers/env
    set +a
    scm_host="${SCM_HOST:-${GITHUB_HOST:-github.com}}"
    scm_username="${SCM_USERNAME:-x-access-token}"
    scm_token_secret_id="${SCM_TOKEN_SECRET_ID:-${GITHUB_PAT_SECRET_ID:-}}"

    # Return no credentials for unrelated hosts so other helpers can handle them.
    if [ "$host" != "$scm_host" ]; then
      exit 0
    fi
    if [ -z "$scm_token_secret_id" ]; then
      echo "SCM_TOKEN_SECRET_ID is not configured" >&2
      exit 1
    fi

    # SecretString is expected to be the raw token, not a JSON object.
    token="$(aws secretsmanager get-secret-value \
      --region "$AWS_REGION" \
      --secret-id "$scm_token_secret_id" \
      --query SecretString \
      --output text)"

    printf 'username=%s\n' "$scm_username"
    printf 'password=%s\n' "$token"
    ;;
  store|erase)
    # Credentials are owned by Secrets Manager; never persist or erase locally.
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
