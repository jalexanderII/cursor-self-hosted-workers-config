# Copy this block into an example root as backend.tf, then supply environment-
# specific values through `terraform init -backend-config=...`. Never commit
# credentials or customer bucket names to this repository.
terraform {
  backend "s3" {
    bucket       = "REPLACE_ME_TERRAFORM_STATE_BUCKET"
    key          = "cursor-self-hosted-workers/REPLACE_ME/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
