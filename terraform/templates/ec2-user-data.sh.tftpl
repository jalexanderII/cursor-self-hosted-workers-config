#!/usr/bin/env bash
set -euo pipefail

LOG_FILE="/var/log/cursor-workers-bootstrap.log"
exec > >(tee -a "$${LOG_FILE}") 2>&1

echo "Starting Cursor worker bootstrap at $(date -Is)"

export DEBIAN_FRONTEND=noninteractive
apt-get update
# Ubuntu 24.04+ no longer ships the awscli apt package.
apt-get install -y --no-install-recommends ca-certificates curl git jq python3 sudo unzip
if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  unzip -qo /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install -b /usr/local/bin
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi

if ! id "${worker_user}" >/dev/null 2>&1; then
  useradd -m -s /bin/bash "${worker_user}"
fi
worker_group="$(id -gn "${worker_user}")"

install -d -m 0755 /etc/cursor-workers
install -d -m 0755 /usr/local/bin
install -d -m 0755 /var/lib/cursor-workers
install -d -m 0755 /opt/cursor-workers
install -d -m 0755 /tmp/cursor-bootstrap
chown -R "${worker_user}:${worker_user}" /opt/cursor-workers

# Worker scripts/units ship as one compressed tarball so Launch Template user
# data stays under the 16 KiB limit (embedding many base64 blobs does not).
printf '%s' "${bootstrap_assets_b64}" | base64 -d | tar -xz -C /tmp/cursor-bootstrap
install -m 0755 -o root -g root /tmp/cursor-bootstrap/bin/* /usr/local/bin/
install -m 0644 -o root -g root /tmp/cursor-bootstrap/systemd/* /etc/systemd/system/
rm -rf /tmp/cursor-bootstrap

write_b64_file() {
  local mode="$1"
  local owner="$2"
  local target="$3"
  local encoded="$4"
  tmp="$(mktemp)"
  printf '%s' "$encoded" | base64 -d > "$tmp"
  install -m "$mode" -o "$owner" -g "$owner" "$tmp" "$target"
  rm -f "$tmp"
}

write_b64_file 0640 root /etc/cursor-workers/env "${env_file_b64}"
write_b64_file 0640 root /etc/cursor-workers/labels.json "${labels_json_b64}"
write_b64_file 0640 root /etc/cursor-workers/workers.json "${workers_json_b64}"
chgrp "$worker_group" /etc/cursor-workers/env /etc/cursor-workers/labels.json /etc/cursor-workers/workers.json

%{ if repo_env_files_b64 != "" ~}
write_b64_file 0640 root /etc/cursor-workers/repo-env-files "${repo_env_files_b64}"
chgrp "$worker_group" /etc/cursor-workers/repo-env-files
%{ endif ~}

sudo -u "${worker_user}" git config --global credential.helper /usr/local/bin/git-credential-scm-secretsmanager
rm -f "/home/${worker_user}/.git-credentials"

if ! sudo -u "${worker_user}" bash -lc 'command -v agent >/dev/null 2>&1'; then
  sudo -u "${worker_user}" bash -lc 'curl --proto "=https" --tlsv1.2 -fsSL "${cursor_install_url}" -o /tmp/install-cursor.sh && bash /tmp/install-cursor.sh && rm -f /tmp/install-cursor.sh'
fi

set -a
. /etc/cursor-workers/env
set +a

for secret_id in "$CURSOR_API_SECRET_ID" "$SCM_TOKEN_SECRET_ID"; do
  secret_ready=0
  for attempt in {1..120}; do
    if aws secretsmanager get-secret-value \
      --region "$AWS_REGION" \
      --secret-id "$secret_id" \
      --query SecretString \
      --output text >/dev/null 2>&1; then
      secret_ready=1
      break
    fi

    echo "Waiting for secret value $secret_id, attempt $${attempt}/120"
    sleep 10
  done
  if [[ "$secret_ready" != "1" ]]; then
    echo "Secret value $secret_id was not available after waiting." >&2
    exit 1
  fi
done

systemctl daemon-reload
systemctl enable --now cursor-workers-autoscale.timer
systemctl enable --now cursor-workers-metrics.timer

/usr/local/bin/cursor-workers-reconcile

echo "Cursor worker bootstrap complete at $(date -Is)"
